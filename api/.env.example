# Connection strings
DATABASE_URL="postgresql://user:password@localhost:5432/iwishbag?schema=public"
DATABASE_POOLED_URL="postgresql://user:password@localhost:5432/iwishbag?schema=public"
DATABASE_URL_STAGING="postgresql://user:password@localhost:5432/iwishbag_staging?schema=public"

# Authentication
JWT_SECRET="replace-with-secure-random-string"
FRONTEND_URL="http://localhost:3000"

# Observability
BETTERSTACK_LOGS_TOKEN=""
BETTERSTACK_LOGS_ENDPOINT="https://in.logs.betterstack.com"
POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_API_KEY=""

# Email (Postmark or SES proxy)
POSTMARK_API_TOKEN=""
PASSWORD_RESET_EMAIL_FROM="support@example.com"

# Search (optional local MeiliSearch)
MEILISEARCH_URL="http://127.0.0.1:7700"
MEILISEARCH_KEY=""

# Email (AWS SES)
SES_SMTP_USER=""
SES_SMTP_PASS=""

# Messaging & alerts
SPARROW_SMS_TOKEN=""
PAGERDUTY_INTEGRATION_KEY=""

# AWS SQS queues (optional)
