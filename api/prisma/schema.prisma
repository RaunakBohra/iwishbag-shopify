generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  FREE
  PRO
  MAX
}

enum UserRole {
  OWNER
  STAFF
  PLATFORM_ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductOptionType {
  TEXT
  SWATCH
  IMAGE
}

enum CollectionVisibility {
  PUBLIC
  PRIVATE
}

enum InventoryAdjustmentReason {
  MANUAL
  SHIPMENT_RECEIVED
  ORDER_FULFILLED
  DAMAGE
  OTHER
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum FulfillmentStatus {
  PENDING
  IN_PROGRESS
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingRateType {
  FLAT
  WEIGHT
  PRICE
}

model ShippingProfile {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  isDefault   Boolean        @default(false)
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  zones       ShippingZone[]

  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
}

model ShippingZone {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  profileId String
  profile   ShippingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  provinces Json?
  districts Json?
  metadata  Json?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  rates     ShippingRate[]

  @@index([tenantId, isActive])
}

model ShippingRate {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  zoneId          String
  zone            ShippingZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  type            ShippingRateType @default(FLAT)
  amount          Decimal          @default("0") @db.Decimal(10, 2)
  minWeight       Decimal?         @db.Decimal(10, 2)
  maxWeight       Decimal?         @db.Decimal(10, 2)
  minSubtotal     Decimal?         @db.Decimal(10, 2)
  maxSubtotal     Decimal?         @db.Decimal(10, 2)
  minDeliveryDays Int?
  maxDeliveryDays Int?
  isActive        Boolean          @default(true)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId, isActive])
}

model ShippingProvider {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  name        String
  slug        String
  credentials Json?
  isActive    Boolean    @default(true)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  shipments   Shipment[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
}

model Shipment {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillmentId  String?
  fulfillment    Fulfillment?      @relation(fields: [fulfillmentId], references: [id])
  providerId     String?
  provider       ShippingProvider? @relation(fields: [providerId], references: [id])
  trackingNumber String?
  trackingUrl    String?
  status         String?           @default("pending")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([orderId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountAllocation {
  ORDER
  PRODUCT
}

model FeatureFlag {
  id          String              @id @default(cuid())
  tenantId    String?
  tenant      Tenant?             @relation(fields: [tenantId], references: [id])
  key         String
  description String?
  strategy    Json?
  isActive    Boolean             @default(true)
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenantFlags TenantFeatureFlag[]

  @@unique([tenantId, key])
}

model TenantFeatureFlag {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  flagId    String
  flag      FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  value     Boolean     @default(true)
  rollout   Json?
  metadata  Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([tenantId, flagId])
}

model Setting {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  key       String
  value     Json?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

model BackgroundJob {
  id                   String                 @id @default(cuid())
  tenantId             String?
  tenant               Tenant?                @relation(fields: [tenantId], references: [id])
  type                 String
  payload              Json?
  status               String                 @default("pending")
  runAt                DateTime               @default(now())
  attempts             Int                    @default(0)
  lastError            String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  BackgroundJobFailure BackgroundJobFailure[]

  @@index([tenantId, status])
  @@index([runAt])
}

model BackgroundJobFailure {
  id         String        @id @default(cuid())
  jobId      String
  job        BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  error      String
  metadata   Json?
  occurredAt DateTime      @default(now())
  tenantId   String?
  tenant     Tenant?       @relation(fields: [tenantId], references: [id])
}

model TenantPayoutMethod {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  provider         String
  providerMethodId String
  displayDetails   String
  isDefault        Boolean  @default(false)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payouts          Payout[]

  @@unique([tenantId, providerMethodId])
  @@index([tenantId, isDefault])
}

model FinancialTransaction {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id])
  paymentId         String?
  payment           Payment?  @relation(fields: [paymentId], references: [id])
  refundId          String?
  refund            Refund?   @relation(fields: [refundId], references: [id])
  type              String
  status            String?
  amount            Decimal   @default("0") @db.Decimal(12, 2)
  currency          String    @default("NPR")
  originalAmount    Decimal?  @db.Decimal(12, 2)
  originalCurrency  String?
  exchangeRate      Decimal?  @db.Decimal(12, 6)
  provider          String?
  providerReference String?
  metadata          Json?
  occurredAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  Discount          Discount? @relation(fields: [discountId], references: [id])
  discountId        String?

  @@index([tenantId, occurredAt])
  @@index([orderId])
  @@index([paymentId])
  @@index([refundId])
}

model TenantBalance {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  currency         String   @default("NPR")
  availableBalance Decimal  @default("0") @db.Decimal(12, 2)
  pendingBalance   Decimal  @default("0") @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt
  metadata         Json?

  @@unique([tenantId, currency])
}

model BalanceTransaction {
  id                  String                @id @default(cuid())
  tenantId            String
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  currency            String                @default("NPR")
  amount              Decimal               @default("0") @db.Decimal(12, 2)
  type                String
  sourceOrderId       String?
  sourceOrder         Order?                @relation(fields: [sourceOrderId], references: [id])
  sourcePaymentId     String?
  sourcePayment       Payment?              @relation(fields: [sourcePaymentId], references: [id])
  sourceRefundId      String?
  sourceRefund        Refund?               @relation(fields: [sourceRefundId], references: [id])
  payoutId            String?
  payout              Payout?               @relation(fields: [payoutId], references: [id])
  metadata            Json?
  occurredAt          DateTime              @default(now())
  GiftCardTransaction GiftCardTransaction[]

  @@index([tenantId, occurredAt])
}

model Payout {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  amount              Decimal              @default("0") @db.Decimal(12, 2)
  currency            String               @default("NPR")
  status              String               @default("requested")
  provider            String?
  providerPayoutId    String?
  payoutMethodId      String?
  payoutMethod        TenantPayoutMethod?  @relation(fields: [payoutMethodId], references: [id])
  initiatedAt         DateTime             @default(now())
  completedAt         DateTime?
  failedAt            DateTime?
  failureReason       String?
  metadata            Json?
  balanceTransactions BalanceTransaction[]

  @@index([tenantId, status])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  subject   String
  body      Json?
  category  String?
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model SmsTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  message   String
  category  String?
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model PageView {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  path       String
  referrer   String?
  userAgent  String?
  ipAddress  String?
  sessionId  String?
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([tenantId, occurredAt])
}

model AnalyticsEvent {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  properties Json?
  occurredAt DateTime  @default(now())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId, occurredAt])
  @@index([customerId])
}

model LoyaltyProgram {
  id           String               @id @default(cuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  name         String
  description  String?
  isActive     Boolean              @default(true)
  config       Json?
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions LoyaltyTransaction[]
  referrals    Referral[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model LoyaltyTransaction {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  programId  String
  program    LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id])
  type       String
  points     Int            @default(0)
  balance    Int            @default(0)
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([tenantId])
  @@index([customerId])
}

model Referral {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  programId          String?
  program            LoyaltyProgram? @relation(fields: [programId], references: [id])
  referrerCustomerId String?
  referrerCustomer   Customer?       @relation("ReferrerReferrals", fields: [referrerCustomerId], references: [id])
  referredCustomerId String?
  referredCustomer   Customer?       @relation("ReferredReferrals", fields: [referredCustomerId], references: [id])
  referredEmail      String?
  status             String?         @default("pending")
  metadata           Json?
  createdAt          DateTime        @default(now())
  convertedAt        DateTime?

  @@index([tenantId, status])
  @@index([referrerCustomerId])
  @@index([referredCustomerId])
}

model SubscriptionPlan {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  priceMonthly      Decimal  @default("0") @db.Decimal(10, 2)
  priceYearly       Decimal  @default("0") @db.Decimal(10, 2)
  maxProducts       Int      @default(-1)
  maxOrdersPerMonth Int      @default(-1)
  maxStaff          Int      @default(1)
  maxStorageGb      Int      @default(1)
  maxEmailPerMonth  Int      @default(0)
  maxSmsPerMonth    Int      @default(0)
  features          Json?
  isActive          Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenants           Tenant[]
}

model TenantSetting {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  preferences Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  config      Json?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  stores      Store[]
}

model Store {
  id             String        @id @default(cuid())
  tenantId       String        @unique
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  name           String
  slug           String        @unique
  description    String?
  themeId        String?
  theme          Theme?        @relation(fields: [themeId], references: [id])
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?
  settings       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  domains        StoreDomain[]

  @@index([themeId])
}

model StoreDomain {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  hostname   String    @unique
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Menu {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  name      String
  handle    String
  location  String?
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]

  @@unique([tenantId, handle])
  @@index([tenantId, position])
}

model MenuItem {
  id        String     @id @default(cuid())
  menuId    String
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("MenuItemChildren")
  titleEn   String
  titleNe   String?
  url       String?
  linkType  String?
  targetId  String?
  position  Int        @default(0)
  isVisible Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([menuId, position])
}

model Page {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  titleEn         String
  titleNe         String?
  slug            String
  status          PageStatus  @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  blocks          PageBlock[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model PageBlock {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockType String
  content   Json?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, position])
}

model Customer {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  email               String?
  phone               String?
  firstName           String?
  lastName            String?
  preferredLocale     String?
  status              String?              @default("active")
  tags                Json?
  attributes          Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  addresses           CustomerAddress[]
  carts               Cart[]
  orders              Order[]
  discountUsages      DiscountUsage[]
  giftCards           GiftCard[]
  loyaltyTransactions LoyaltyTransaction[]
  referralsMade       Referral[]           @relation("ReferrerReferrals")
  referralsReceived   Referral[]           @relation("ReferredReferrals")
  analyticsEvents     AnalyticsEvent[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model CustomerAddress {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label             String?
  firstName         String?
  lastName          String?
  phone             String?
  email             String?
  addressLine1      String
  addressLine2      String?
  city              String?
  province          String?
  district          String?
  postalCode        String?
  country           String?  @default("NP")
  isDefaultBilling  Boolean  @default(false)
  isDefaultShipping Boolean  @default(false)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId, customerId])
}

model Cart {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  status        CartStatus @default(ACTIVE)
  currency      String     @default("NPR")
  subtotal      Decimal    @default("0") @db.Decimal(10, 2)
  total         Decimal    @default("0") @db.Decimal(10, 2)
  discountTotal Decimal    @default("0") @db.Decimal(10, 2)
  taxTotal      Decimal    @default("0") @db.Decimal(10, 2)
  expiresAt     DateTime?
  attributes    Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         CartItem[]
  order         Order?     @relation("CartOrder")

  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model CartItem {
  id         String          @id @default(cuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int             @default(1)
  unitPrice  Decimal         @default("0") @db.Decimal(10, 2)
  subtotal   Decimal         @default("0") @db.Decimal(10, 2)
  attributes Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([cartId])
}

model Order {
  id                    String                 @id @default(cuid())
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  orderNumber           String
  customerId            String?
  customer              Customer?              @relation(fields: [customerId], references: [id])
  cartId                String?                @unique
  cart                  Cart?                  @relation("CartOrder", fields: [cartId], references: [id])
  status                OrderStatus            @default(PENDING)
  currency              String                 @default("NPR")
  subtotal              Decimal                @default("0") @db.Decimal(10, 2)
  discountTotal         Decimal                @default("0") @db.Decimal(10, 2)
  shippingTotal         Decimal                @default("0") @db.Decimal(10, 2)
  taxTotal              Decimal                @default("0") @db.Decimal(10, 2)
  total                 Decimal                @default("0") @db.Decimal(10, 2)
  billingAddress        Json?
  shippingAddress       Json?
  note                  String?
  metadata              Json?
  placedAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  items                 OrderItem[]
  taxLines              OrderTaxLine[]
  shippingLines         OrderShippingLine[]
  events                OrderEvent[]
  payments              Payment[]
  fulfillments          Fulfillment[]
  refunds               Refund[]
  shipments             Shipment[]
  discountUsages        DiscountUsage[]
  giftCardTransactions  GiftCardTransaction[]
  financialTransactions FinancialTransaction[]
  balanceTransactions   BalanceTransaction[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id               String            @id @default(cuid())
  orderId          String
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?          @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant?   @relation(fields: [variantId], references: [id])
  title            String
  sku              String?
  quantity         Int               @default(1)
  unitPrice        Decimal           @default("0") @db.Decimal(10, 2)
  subtotal         Decimal           @default("0") @db.Decimal(10, 2)
  discountTotal    Decimal           @default("0") @db.Decimal(10, 2)
  taxTotal         Decimal           @default("0") @db.Decimal(10, 2)
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  fulfillmentItems FulfillmentItem[]

  @@index([orderId])
}

model OrderTaxLine {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title     String?
  rate      Decimal? @db.Decimal(6, 4)
  amount    Decimal  @default("0") @db.Decimal(10, 2)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderShippingLine {
  id               String    @id @default(cuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier          String?
  service          String?
  amount           Decimal   @default("0") @db.Decimal(10, 2)
  taxTotal         Decimal   @default("0") @db.Decimal(10, 2)
  trackingNumber   String?
  trackingUrl      String?
  estimatedArrival DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String?
  data      Json?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id                   String                 @id @default(cuid())
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  orderId              String
  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status               PaymentStatus          @default(PENDING)
  provider             String
  providerPaymentId    String
  method               String?
  amount               Decimal                @default("0") @db.Decimal(10, 2)
  currency             String                 @default("NPR")
  capturedAmount       Decimal                @default("0") @db.Decimal(10, 2)
  refundedAmount       Decimal                @default("0") @db.Decimal(10, 2)
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  attempts             PaymentAttempt[]
  refunds              Refund[]
  FinancialTransaction FinancialTransaction[]
  BalanceTransaction   BalanceTransaction[]

  @@unique([tenantId, provider, providerPaymentId])
  @@index([orderId])
}

model PaymentAttempt {
  id           String        @id @default(cuid())
  paymentId    String
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status       PaymentStatus @default(PENDING)
  errorCode    String?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([paymentId])
}

model Refund {
  id                   String                 @id @default(cuid())
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  orderId              String?
  order                Order?                 @relation(fields: [orderId], references: [id])
  paymentId            String
  payment              Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount               Decimal                @default("0") @db.Decimal(10, 2)
  currency             String                 @default("NPR")
  reason               String?
  status               String?                @default("pending")
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  balanceTransactions  BalanceTransaction[]
  FinancialTransaction FinancialTransaction[]

  @@index([tenantId])
  @@index([paymentId])
}

model Fulfillment {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          FulfillmentStatus  @default(PENDING)
  trackingNumber  String?
  trackingCompany String?
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           FulfillmentItem[]
  events          FulfillmentEvent[]
  shipments       Shipment[]

  @@index([orderId])
}

model FulfillmentItem {
  id            String      @id @default(cuid())
  fulfillmentId String
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id])
  quantity      Int         @default(0)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([fulfillmentId])
}

model FulfillmentEvent {
  id            String      @id @default(cuid())
  fulfillmentId String
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  type          String
  message       String?
  data          Json?
  createdBy     String?
  createdAt     DateTime    @default(now())

  @@index([fulfillmentId])
}

model Discount {
  id                    String                 @id @default(cuid())
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  title                 String
  code                  String?
  type                  DiscountType           @default(PERCENTAGE)
  allocation            DiscountAllocation     @default(ORDER)
  value                 Decimal                @default("0") @db.Decimal(10, 2)
  minimumSubtotal       Decimal?               @db.Decimal(10, 2)
  maximumSubtotal       Decimal?               @db.Decimal(10, 2)
  startsAt              DateTime
  endsAt                DateTime?
  usageLimit            Int?
  usageLimitPerCustomer Int?
  usageCount            Int                    @default(0)
  isStackable           Boolean                @default(false)
  status                String                 @default("draft")
  metadata              Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  rules                 DiscountRule[]
  conditions            DiscountCondition[]
  usages                DiscountUsage[]
  financialTransactions FinancialTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model DiscountRule {
  id          String   @id @default(cuid())
  discountId  String
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  appliesOnce Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([discountId])
}

model DiscountCondition {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  type       String
  operator   String?
  values     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([discountId])
}

model DiscountUsage {
  id         String    @id @default(cuid())
  discountId String
  discount   Discount  @relation(fields: [discountId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id])
  usedAt     DateTime  @default(now())
  metadata   Json?

  @@index([discountId])
  @@index([customerId])
  @@index([orderId])
}

model GiftCard {
  id             String                @id @default(cuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  code           String                @unique
  initialBalance Decimal               @default("0") @db.Decimal(10, 2)
  currentBalance Decimal               @default("0") @db.Decimal(10, 2)
  currency       String                @default("NPR")
  isActive       Boolean               @default(true)
  expiresAt      DateTime?
  customerId     String?
  customer       Customer?             @relation(fields: [customerId], references: [id])
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  transactions   GiftCardTransaction[]
}

model GiftCardTransaction {
  id                   String              @id @default(cuid())
  giftCardId           String
  giftCard             GiftCard            @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId              String?
  order                Order?              @relation(fields: [orderId], references: [id])
  type                 String
  amount               Decimal             @default("0") @db.Decimal(10, 2)
  balance              Decimal             @default("0") @db.Decimal(10, 2)
  metadata             Json?
  createdAt            DateTime            @default(now())
  balanceTransactionId String?
  balanceTransaction   BalanceTransaction? @relation(fields: [balanceTransactionId], references: [id])

  @@index([giftCardId])
}

model TaxRate {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  name      String
  rate      Decimal       @db.Decimal(6, 4)
  country   String        @default("NP")
  province  String?
  district  String?
  isDefault Boolean       @default(false)
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  overrides TaxOverride[]

  @@index([tenantId, isDefault])
}

model TaxOverride {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  taxRateId   String
  taxRate     TaxRate  @relation(fields: [taxRateId], references: [id], onDelete: Cascade)
  level       String
  referenceId String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([taxRateId])
}

model Tenant {
  id                       String                 @id @default(cuid())
  name                     String
  slug                     String                 @unique
  plan                     PlanTier               @default(FREE)
  planStatus               String                 @default("trial")
  trialEndsAt              DateTime?
  email                    String?                @unique
  phone                    String?
  businessName             String?
  businessType             String?
  panNumber                String?
  vatNumber                String?
  registrationNumber       String?
  paymentProviderAccountId String?
  maxProducts              Int?                   @default(25)
  maxOrdersPerMonth        Int?                   @default(50)
  maxStaff                 Int?                   @default(1)
  maxStorageGb             Int?                   @default(1)
  timezone                 String                 @default("Asia/Kathmandu")
  currency                 String                 @default("NPR")
  language                 String                 @default("ne")
  dateFormat               String                 @default("YYYY/MM/DD")
  status                   String                 @default("pending")
  kycStatus                String                 @default("pending")
  kycSubmittedAt           DateTime?
  kycApprovedAt            DateTime?
  metadata                 Json?
  planId                   String?
  subscription             TenantSubscription?
  usage                    TenantUsage?
  store                    Store?
  settingsRecord           TenantSetting?
  planReference            SubscriptionPlan?      @relation(fields: [planId], references: [id])
  invitees                 Invite[]
  products                 Product[]
  collections              ProductCollection[]
  tags                     ProductTag[]
  inventory                ProductInventory[]
  inventoryAdjustments     InventoryAdjustment[]
  users                    User[]
  roles                    Role[]
  menus                    Menu[]
  pages                    Page[]
  customers                Customer[]
  carts                    Cart[]
  orders                   Order[]
  payments                 Payment[]
  refunds                  Refund[]
  fulfillments             Fulfillment[]
  discounts                Discount[]
  giftCards                GiftCard[]
  taxRates                 TaxRate[]
  taxOverrides             TaxOverride[]
  shippingProfiles         ShippingProfile[]
  shippingZones            ShippingZone[]
  shippingRates            ShippingRate[]
  shippingProviders        ShippingProvider[]
  shipments                Shipment[]
  featureFlags             FeatureFlag[]
  tenantFeatureFlags       TenantFeatureFlag[]
  configurationSettings    Setting[]
  backgroundJobs           BackgroundJob[]
  backgroundJobFailures    BackgroundJobFailure[]
  integrations             Integration[]
  tenantPayoutMethods      TenantPayoutMethod[]
  emailTemplates           EmailTemplate[]
  smsTemplates             SmsTemplate[]
  pageViews                PageView[]
  analyticsEvents          AnalyticsEvent[]
  loyaltyPrograms          LoyaltyProgram[]
  loyaltyTransactions      LoyaltyTransaction[]
  referrals                Referral[]
  financialTransactions    FinancialTransaction[]
  tenantBalances           TenantBalance[]
  balanceTransactions      BalanceTransaction[]
  payouts                  Payout[]
  auditLogs                AuditLog[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deletedAt                DateTime?
  CustomerAddress          CustomerAddress[]

  @@index([planId])
}

model User {
  id              String               @id @default(cuid())
  tenantId        String?
  tenant          Tenant?              @relation(fields: [tenantId], references: [id])
  email           String               @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole
  avatarUrl       String?
  locale          String?              @default("en")
  lastLoginAt     DateTime?
  lastLoginIp     String?
  invite          Invite?              @relation("invitee")
  inviteId        String?              @unique
  invitedUsers    Invite[]             @relation("inviter")
  roleAssignments UserRoleAssignment[]
  auditLogs       AuditLog[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
}

model Role {
  id          String               @id @default(cuid())
  tenantId    String?
  tenant      Tenant?              @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  isDefault   Boolean              @default(false)
  users       UserRoleAssignment[]
  permissions RolePermission[]
  invites     Invite[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([tenantId, name])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
}

model UserRoleAssignment {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Invite {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  email      String
  inviterId  String
  inviter    User             @relation("inviter", fields: [inviterId], references: [id])
  roleId     String
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  inviteeId  String?          @unique
  invitee    User?            @relation("invitee", fields: [inviteeId], references: [id])
  status     InvitationStatus @default(PENDING)
  token      String           @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Product {
  id                   String                        @id @default(cuid())
  tenantId             String
  tenant               Tenant                        @relation(fields: [tenantId], references: [id])
  title                String
  description          String?
  sku                  String?
  price                Decimal                       @db.Decimal(10, 2)
  inventory            Int                           @default(0)
  status               ProductStatus                 @default(DRAFT)
  variants             ProductVariant[]
  images               ProductImage[]
  options              ProductOption[]
  tags                 ProductTagging[]
  collections          ProductCollectionAssignment[]
  inventoryEntries     ProductInventory[]
  inventoryAdjustments InventoryAdjustment[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  lowStockThreshold    Int?                          @default(5)
  lastLowStockAlertAt  DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  deletedAt            DateTime?

  @@index([tenantId])
}

model ProductVariant {
  id                   String                @id @default(cuid())
  productId            String
  product              Product               @relation(fields: [productId], references: [id])
  name                 String
  sku                  String?
  price                Decimal?              @db.Decimal(10, 2)
  inventory            Int                   @default(0)
  optionValues         ProductOptionValue[]
  inventoryEntries     ProductInventory[]
  inventoryAdjustments InventoryAdjustment[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([productId])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  url         String
  alt         String?
  position    Int      @default(0)
  objectKey   String?
  contentType String?
  fileSize    Int?
  createdAt   DateTime @default(now())
}

model ProductInventory {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  available         Int             @default(0)
  reserved          Int             @default(0)
  incoming          Int             @default(0)
  lowStockThreshold Int?            @default(5)
  lastAlertAt       DateTime?
  updatedAt         DateTime        @updatedAt

  @@unique([productId, variantId])
  @@index([tenantId])
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id])
  name      String
  type      ProductOptionType    @default(TEXT)
  position  Int                  @default(0)
  values    ProductOptionValue[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ProductOptionValue {
  id        String          @id @default(cuid())
  optionId  String
  option    ProductOption   @relation(fields: [optionId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  value     String
  swatch    String?
  createdAt DateTime        @default(now())

  @@index([optionId])
  @@index([variantId])
}

model ProductTag {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  name      String
  slug      String
  products  ProductTagging[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, slug])
}

model ProductTagging {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  tagId     String
  tag       ProductTag @relation(fields: [tagId], references: [id])
}

model InventoryAdjustment {
  id        String                    @id @default(cuid())
  tenantId  String
  tenant    Tenant                    @relation(fields: [tenantId], references: [id])
  productId String
  product   Product                   @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant?           @relation(fields: [variantId], references: [id])
  quantity  Int
  reason    InventoryAdjustmentReason @default(MANUAL)
  memo      String?
  createdBy String
  createdAt DateTime                  @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([variantId])
}

model ProductCollection {
  id          String                        @id @default(cuid())
  tenantId    String
  tenant      Tenant                        @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  slug        String
  visibility  CollectionVisibility          @default(PUBLIC)
  position    Int                           @default(0)
  products    ProductCollectionAssignment[]
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@unique([tenantId, slug])
}

model ProductCollectionAssignment {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  collectionId String
  collection   ProductCollection @relation(fields: [collectionId], references: [id])
  position     Int               @default(0)

  @@index([productId])
  @@index([collectionId])
}

model TenantSubscription {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  plan               PlanTier
  status             String   @default("active")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  externalId         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TenantUsage {
  id          String    @id @default(cuid())
  tenantId    String    @unique
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Int       @default(0)
  variants    Int       @default(0)
  images      Int       @default(0)
  staff       Int       @default(0)
  orders      Int       @default(0)
  lastResetAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  metadata  Json
  createdAt DateTime @default(now())
}

model Integration {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  provider    String
  category    String?
  status      String   @default("inactive")
  config      Json?
  credentials Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([tenantId, provider])
}
